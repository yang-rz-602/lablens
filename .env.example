# LabLens 环境变量示例
#
# 复制为 .env 后填入。**不配置任何一项也能运行** ——
# 系统会自动降级到「离线抽取式解读」+「BM25 词法检索 + 确定性重排」，
# 判读、检索、拒答、护栏全部照常工作（见 README「配置模型与向量检索」）。
#
# ⚠️ 使用云端模型时，报告图片会发送至模型服务商。对真实患者数据请改用本地推理。

# ---- 方式一：使用预设供应商（任选其一）----
# 通义千问 · 阿里云百炼（视觉能力强，推荐）
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# SiliconFlow 硅基流动
SILICONFLOW_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek（无视觉能力，只能用于解释层，不能做报告图抽取）
DEEPSEEK_API_KEY=

# 显式指定用哪个供应商（可选）。默认按 dashscope → zhipu → siliconflow → openai → deepseek 顺序探测
# LABLENS_PROVIDER=dashscope

# ---- 方式二：自定义 / 本地推理服务 ----
# 本地 vLLM（推荐用于真实数据）：
#   vllm serve Qwen/Qwen3-VL-8B-Instruct --port 8000
# LOCAL_LLM_API_KEY=EMPTY
# LABLENS_BASE_URL=http://localhost:8000/v1
# LABLENS_MODEL=Qwen/Qwen3-VL-8B-Instruct
# LABLENS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---- 可选的模型覆盖 ----
# LABLENS_MODEL=qwen-plus
# LABLENS_VISION_MODEL=qwen3-vl-plus

# ---- 检索层（向量库 + 重排）----
# 向量检索与交叉编码器重排都复用 DASHSCOPE_API_KEY；
# **没有它时自动降级为 BM25 + 确定性词面重排**，功能完整只是没有语义能力。
#
# 可用的重排模型：gte-rerank-v2（默认）/ qwen3-rerank / gte-rerank
# LABLENS_EMBED_MODEL=text-embedding-v4
# LABLENS_RERANK_MODEL=gte-rerank-v2

