# LabLens 环境变量示例
#
# 复制为 .env 后填入。**不配置任何一项也能运行** ——
# 系统会自动降级到离线抽取式解读（每句话都来自知识库原文，不存在幻觉风险）。
#
# ⚠️ 使用云端模型时，报告图片会发送至模型服务商。对真实患者数据请改用本地推理。

# ---- 方式一：使用预设供应商（任选其一）----
# 通义千问 · 阿里云百炼（视觉能力强，推荐）
DASHSCOPE_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# SiliconFlow 硅基流动
SILICONFLOW_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek（无视觉能力，只能用于解释层，不能做报告图抽取）
DEEPSEEK_API_KEY=

# 显式指定用哪个供应商（可选）。默认按 dashscope → zhipu → siliconflow → openai → deepseek 顺序探测
# LABLENS_PROVIDER=dashscope

# ---- 方式二：自定义 / 本地推理服务 ----
# 本地 vLLM（推荐用于真实数据）：
#   vllm serve Qwen/Qwen3-VL-8B-Instruct --port 8000
# LOCAL_LLM_API_KEY=EMPTY
# LABLENS_BASE_URL=http://localhost:8000/v1
# LABLENS_MODEL=Qwen/Qwen3-VL-8B-Instruct
# LABLENS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---- 可选的模型覆盖 ----
# LABLENS_MODEL=qwen-plus
# LABLENS_VISION_MODEL=qwen3-vl-plus
